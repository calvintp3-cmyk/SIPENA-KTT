# ==============================================================================
# SIPENA KTT — Environment Variables Example
# Salin file ini menjadi `.env` lalu isi seluruh nilai rahasia sebelum jalankan app.
# Jangan pernah meng-commit file `.env` asli ke version control.
# ==============================================================================

# 1. Database PostgreSQL Lokal VPS Ubuntu 24.04
# Format: postgresql://<db_user>:<db_password>@127.0.0.1:5432/<db_name>
DATABASE_URL=postgresql://sipena_user:GANTI_PASSWORD_DB_KUAT@127.0.0.1:5432/sipena_ktt

# 2. Google AI Studio API Key (Free Tier — Gemini 3.8 Flash & 3.5 Flash-Lite)
GEMINI_API_KEY=GANTI_DENGAN_GEMINI_API_KEY_ANDA

# 3. Session Encryption Key (Minimal 32 karakter acak, mis. hasil `openssl rand -hex 32`)
NUXT_SESSION_PASSWORD=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER

# 4. Internal Cron Endpoint Secret (untuk fallback crontab VPS -> /api/cron/trigger)
CRON_SECRET=GANTI_DENGAN_CRON_SECRET_ACAK_MINIMAL_32_KARAKTER

# 5. Scheduler & Scraper Guardrails
ENABLE_NITRO_CRON=true
SCRAPER_MAX_LLM_CALLS_PER_RUN=150

# 6. Initial Admin Seeding (`npm run db:seed`)
ADMIN_SEED_EMAIL=admin@sipena-ktt.go.id
ADMIN_SEED_NAME="Admin Nerwilis BPS KTT"
ADMIN_SEED_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_KUAT_MIN_12_CHAR

