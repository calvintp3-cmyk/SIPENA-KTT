# ==============================================================================
# SIPENA KTT — Environment Variables Example
# Salin file ini menjadi `.env` lalu isi nilai sesuai konfigurasi server Anda.
# Jangan pernah meng-commit file `.env` asli ke version control.
# ==============================================================================

# 1. Server & Runtime Nitro (diselaraskan dengan PM2 & Nginx Reverse Proxy)
NITRO_HOST=127.0.0.1
NITRO_PORT=3002

# 2. Database PostgreSQL Lokal VPS Ubuntu 24.04
# Contoh format: postgresql://sipena_user:PASSWORD_DB_ANDA@127.0.0.1:5432/sipena_ktt
DATABASE_URL=""

# 3. Multi-Provider LLM API Keys (Gratis — Google Gemini + Groq + Opsional OpenRouter)
# Minimal pasang GEMINI_API_KEY dan/atau GROQ_API_KEY agar failover 0ms aktif otomatis.
GEMINI_API_KEY=""
# Opsional: beberapa API key Gemini dari proyek Google berbeda dipisah koma untuk failover kuota harian
GEMINI_API_KEYS=""

# Groq Cloud Free Tier (tanpa kartu kredit: llama-3.3-70b-versatile + llama-3.1-8b-instant)
GROQ_API_KEY=""
# Opsional: beberapa API key Groq tambahan dipisah koma
GROQ_API_KEYS=""

# Opsional Tier-3: OpenRouter Free Models (kosongkan OPENROUTER_FREE_MODEL untuk auto-ranking internal)
OPENROUTER_API_KEY=""
# Opsional: boleh dikosongkan, diisi "openrouter/free", atau daftar model dipisah koma
# contoh: "google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-super-vl:free"
OPENROUTER_FREE_MODEL=""

# Opsional: Override urutan rantai fallback model (format provider:model dipisah koma)
# Default klasifikasi & sintesis: gemini:gemini-3.8-flash,groq:llama-3.3-70b-versatile,gemini:gemini-3.5-flash-lite,groq:llama-3.1-8b-instant
LLM_CLASSIFY_CHAIN=""
LLM_SYNTHESIS_CHAIN=""

# 4. Session & Internal Cron Secrets (minimal 32 karakter acak aman)
NUXT_SESSION_PASSWORD=""
CRON_SECRET=""

# 5. Google OAuth 2.0 (Login with Google untuk Staf Admin Whitelist)
# Callback URI di Google Cloud Console: https://<domain-anda>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Opsional: kosongkan untuk deteksi otomatis host/protokol (atau isi URL callback eksplisit)
GOOGLE_REDIRECT_URI=""

# 6. Super Admin Utama (OAuth-First, tanpa password seed lokal)
# Didaftarkan otomatis sebagai ADMIN oleh `npm run db:seed` & login perdana Google OAuth
SUPERADMIN_EMAIL=""

# 7. Scheduler & Scraper Guardrails
ENABLE_NITRO_CRON=true
SCRAPER_MAX_LLM_CALLS_PER_RUN=150
SCRAPER_MAX_ARTICLES_PER_RUN=35
