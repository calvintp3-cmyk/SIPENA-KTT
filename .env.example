# ==============================================================================
# SIPENA KTT — Environment Variables Example
# Salin file ini menjadi `.env` lalu isi nilai sesuai konfigurasi server Anda.
# Jangan pernah meng-commit file `.env` asli ke version control.
# ==============================================================================

# 1. Server & Runtime Nitro (diselaraskan dengan PM2 & Nginx Reverse Proxy)
NITRO_HOST=127.0.0.1
NITRO_PORT=3002

# 2. Database PostgreSQL Lokal VPS Ubuntu 24.04
# Contoh format: postgresql://sipena_user:PASSWORD_DB_ANDA@127.0.0.1:5432/sipena_ktt
DATABASE_URL=""

# 3. Google AI Studio API Key (Free Tier — Gemini Flash)
GEMINI_API_KEY=""

# 4. Session & Internal Cron Secrets (minimal 32 karakter acak aman)
NUXT_SESSION_PASSWORD=""
CRON_SECRET=""

# 5. Google OAuth 2.0 (Login with Google untuk Staf Admin Whitelist)
# Callback URI di Google Cloud Console: https://<domain-anda>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Opsional: kosongkan untuk deteksi otomatis host/protokol (atau isi URL callback eksplisit)
GOOGLE_REDIRECT_URI=""

# 6. Super Admin Utama (OAuth-First, tanpa password seed lokal)
# Didaftarkan otomatis sebagai ADMIN oleh `npm run db:seed` & login perdana Google OAuth
SUPERADMIN_EMAIL=""

# 7. Scheduler & Scraper Guardrails
ENABLE_NITRO_CRON=true
SCRAPER_MAX_LLM_CALLS_PER_RUN=150
