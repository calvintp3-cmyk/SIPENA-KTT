# ==============================================================================
# SIPENA KTT — Environment Variables Example
# Salin file ini menjadi `.env` lalu isi nilai sesuai konfigurasi server Anda.
# Jangan pernah meng-commit file `.env` asli ke version control.
# ==============================================================================

# 1. Database PostgreSQL Lokal VPS Ubuntu 24.04
# Contoh format: postgresql://<db_user>:<db_password>@127.0.0.1:5432/<db_name>
DATABASE_URL=""

# 2. Google AI Studio API Key (Free Tier — Gemini Flash)
GEMINI_API_KEY=""

# 3. Session Encryption Key (Minimal 32 karakter acak, mis. hasil `openssl rand -hex 32`)
NUXT_SESSION_PASSWORD=""

# 4. Internal Cron Endpoint Secret (untuk fallback crontab VPS -> /api/cron/trigger)
CRON_SECRET=""

# 5. Google OAuth 2.0 (Login with Google untuk Staf Admin Whitelist)
# Callback URI di Google Cloud Console: https://<domain-anda>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Opsional: kosongkan untuk deteksi otomatis host/protokol (atau isi URL callback eksplisit)
GOOGLE_REDIRECT_URI=""

# 6. Scheduler & Scraper Guardrails
ENABLE_NITRO_CRON=true
SCRAPER_MAX_LLM_CALLS_PER_RUN=150

# 7. Initial Admin Seeding (`npm run db:seed`)
ADMIN_SEED_EMAIL=""
ADMIN_SEED_NAME="Admin Nerwilis BPS KTT"
ADMIN_SEED_PASSWORD=""
